#pragma enable_d3d11_debug_symbols
#pragma kernel CSMain_Bake
#pragma kernel CSMain_Standard
#pragma kernel CSMain_GlobalInstance
#pragma kernel CSClearArgs
#pragma kernel CSMain_GlobalInstance_Filtered 
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

Texture2D<float> _HizMipAtlas;
StructuredBuffer<float4> _AABBCenterBuffer;
StructuredBuffer<float4> _AABBExtentBuffer;
RWStructuredBuffer<uint> _CullResultBuffer;

uint _CullableCount;
float4x4 _HizCullVP;
float4 _HizMinMaxMipAndScreenSize;
float4 _HizAtlasMipScaleOffset[16];


// --- 纹理化存储数据绑定 ---
Texture2D _GlobalInstanceDataTex;
RWTexture2D<uint> _GlobalVisibleIndexTex;
uint _TexWidth;

struct GPUInstanceData {
    float4x4 _matrix;
    float4 blockData;
    float3 extents;
    uint batchIndex;
    float4 lodDistances;
};
// ================= 【新增：GPU 烘焙逻辑】 =================
StructuredBuffer<GPUInstanceData> _InputInstanceBuffer; // CPU 快速上传的临时 Buffer
RWTexture2D<float4> _GlobalInstanceDataTexWrite;        // 只写形式的数据贴图
uint _BakeInstanceCount;

[numthreads(64, 1, 1)]
void CSMain_Bake(uint3 id : SV_DispatchThreadID) {
    if (id.x >= _BakeInstanceCount) return;

    GPUInstanceData data = _InputInstanceBuffer[id.x];
    uint baseIdx = id.x * 7;

    // 分配 7 个连续像素坐标，自适应 POT 正方形纹理宽度 _TexWidth
    int2 uv0 = int2((baseIdx + 0) % _TexWidth, (baseIdx + 0) / _TexWidth);
    int2 uv1 = int2((baseIdx + 1) % _TexWidth, (baseIdx + 1) / _TexWidth);
    int2 uv2 = int2((baseIdx + 2) % _TexWidth, (baseIdx + 2) / _TexWidth);
    int2 uv3 = int2((baseIdx + 3) % _TexWidth, (baseIdx + 3) / _TexWidth);
    int2 uv4 = int2((baseIdx + 4) % _TexWidth, (baseIdx + 4) / _TexWidth);
    int2 uv5 = int2((baseIdx + 5) % _TexWidth, (baseIdx + 5) / _TexWidth);
    int2 uv6 = int2((baseIdx + 6) % _TexWidth, (baseIdx + 6) / _TexWidth);

    // 一次性写入正方形纹理
    _GlobalInstanceDataTexWrite[uv0] = data._matrix[0];
    _GlobalInstanceDataTexWrite[uv1] = data._matrix[1];
    _GlobalInstanceDataTexWrite[uv2] = data._matrix[2];
    _GlobalInstanceDataTexWrite[uv3] = data._matrix[3];
    _GlobalInstanceDataTexWrite[uv4] = data.blockData;
    _GlobalInstanceDataTexWrite[uv5] = float4(data.extents, (float)data.batchIndex);
    _GlobalInstanceDataTexWrite[uv6] = data.lodDistances;
}
// =============================================================

// 从 2D 纹理中解码出 Instance 属性数据
GPUInstanceData GetInstanceData(uint instanceId) {
    GPUInstanceData data;
    uint baseIdx = instanceId * 7;
    
    int2 uv0 = int2((baseIdx + 0) % _TexWidth, (baseIdx + 0) / _TexWidth);
    int2 uv1 = int2((baseIdx + 1) % _TexWidth, (baseIdx + 1) / _TexWidth);
    int2 uv2 = int2((baseIdx + 2) % _TexWidth, (baseIdx + 2) / _TexWidth);
    int2 uv3 = int2((baseIdx + 3) % _TexWidth, (baseIdx + 3) / _TexWidth);
    int2 uv4 = int2((baseIdx + 4) % _TexWidth, (baseIdx + 4) / _TexWidth);
    int2 uv5 = int2((baseIdx + 5) % _TexWidth, (baseIdx + 5) / _TexWidth);
    int2 uv6 = int2((baseIdx + 6) % _TexWidth, (baseIdx + 6) / _TexWidth);

    float4 r0 = _GlobalInstanceDataTex.Load(int3(uv0, 0));
    float4 r1 = _GlobalInstanceDataTex.Load(int3(uv1, 0));
    float4 r2 = _GlobalInstanceDataTex.Load(int3(uv2, 0));
    float4 r3 = _GlobalInstanceDataTex.Load(int3(uv3, 0));
    
    data._matrix = float4x4(r0, r1, r2, r3);
    data.blockData = _GlobalInstanceDataTex.Load(int3(uv4, 0));
    
    float4 extBatch = _GlobalInstanceDataTex.Load(int3(uv5, 0));
    data.extents = extBatch.xyz;
    data.batchIndex = (uint)extBatch.w;
    
    data.lodDistances = _GlobalInstanceDataTex.Load(int3(uv6, 0));
    
    return data;
}

// --- 工具函数：坐标转换与可见性判断 ---

float3 TransformWorldToNDC(float3 worldPos)
{
    float4 clipPos = mul(_HizCullVP, float4(worldPos, 1.0));
    float3 ndc = clipPos.xyz / clipPos.w;

    ndc.xy = ndc.xy * 0.5f + 0.5f;

    #if UNITY_UV_STARTS_AT_TOP
    ndc.y = 1.0 - ndc.y; 
    #endif
    
    #if !defined(UNITY_REVERSED_Z)
    ndc.z = ndc.z * 0.5f + 0.5f;
    #endif

    ndc.z = Linear01Depth(ndc.z, _ZBufferParams);
    return ndc.xyz;
}

bool CheckVisable(float3 center, float3 extent) {
    // 阶段 1：视锥剔除
    [unroll]
    for (int p = 0; p < 6; p++)
    {
        float4 plane = _FrustumPlanes[p];
        float r = dot(abs(plane.xyz), extent);
        float d = dot(plane.xyz, center) + plane.w;
        if (d + r < 0) return false;
    }

    // 阶段 2：遮挡剔除 (Hi-Z)
    float3 aabbMaxW = center + extent;
    float3 aabbMinW = center - extent;

    float3 points[8];
    points[0] = TransformWorldToNDC(float3(aabbMinW.x, aabbMinW.y, aabbMinW.z));
    points[1] = TransformWorldToNDC(float3(aabbMinW.x, aabbMinW.y, aabbMaxW.z));
    points[2] = TransformWorldToNDC(float3(aabbMinW.x, aabbMaxW.y, aabbMinW.z));
    points[3] = TransformWorldToNDC(float3(aabbMaxW.x, aabbMinW.y, aabbMinW.z));
    points[4] = TransformWorldToNDC(float3(aabbMaxW.x, aabbMaxW.y, aabbMinW.z));
    points[5] = TransformWorldToNDC(float3(aabbMaxW.x, aabbMinW.y, aabbMaxW.z));
    points[6] = TransformWorldToNDC(float3(aabbMinW.x, aabbMaxW.y, aabbMaxW.z));
    points[7] = TransformWorldToNDC(float3(aabbMaxW.x, aabbMaxW.y, aabbMaxW.z));

    float3 ndcMin = points[0];
    float3 ndcMax = points[0];
    [unroll]
    for(int i=1; i<8; i++) {
        ndcMin = min(ndcMin, points[i]);
        ndcMax = max(ndcMax, points[i]);
    }

    float4 clipPos = mul(_HizCullVP, float4(center, 1.0));
    if (clipPos.w <= _ProjectionParams.y) return true;

    float2 screenAABBSize = (ndcMax.xy - ndcMin.xy) * _HizMinMaxMipAndScreenSize.zw;
    float screenAABBRadius = max(screenAABBSize.x, screenAABBSize.y);
    
    int mipLevel = (int)ceil(log2(screenAABBRadius));
    mipLevel = clamp(mipLevel, (int)_HizMinMaxMipAndScreenSize.x, (int)_HizMinMaxMipAndScreenSize.y);
    
    float4 atlasPixelOffsetSize = _HizAtlasMipScaleOffset[mipLevel];
    ndcMax = clamp(ndcMax, 0.0, 1.0);
    ndcMin = clamp(ndcMin, 0.0, 1.0);

    int4 screenPixelMinMax = (float4(ndcMin.xy, ndcMax.xy) * atlasPixelOffsetSize.xyxy + atlasPixelOffsetSize.zwzw);
    int2 minBoundary = (int2)atlasPixelOffsetSize.zw;
    int2 maxBoundary = (int2)(atlasPixelOffsetSize.zw + atlasPixelOffsetSize.xy - 1.0);

    screenPixelMinMax.xy = clamp(screenPixelMinMax.xy, minBoundary, maxBoundary);
    screenPixelMinMax.zw = clamp(screenPixelMinMax.zw, minBoundary, maxBoundary);

    float lbDepth = _HizMipAtlas.Load(int3(screenPixelMinMax.xy, 0)).r;
    float rbDepth = _HizMipAtlas.Load(int3(screenPixelMinMax.zy, 0)).r;
    float ltDepth = _HizMipAtlas.Load(int3(screenPixelMinMax.xw, 0)).r;
    float rtDepth = _HizMipAtlas.Load(int3(screenPixelMinMax.zw, 0)).r;
    float maxDepth = max(max(max(lbDepth, rbDepth), ltDepth), rtDepth);
    
    return maxDepth > ndcMin.z;
}

// --- Kernel 1: 标准 GameObject 回读剔除 ---

[numthreads(64, 1, 1)]
void CSMain_Standard(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _CullableCount) return;
    float3 center = _AABBCenterBuffer[id.x].xyz;
    float3 extent = _AABBExtentBuffer[id.x].xyz;
    _CullResultBuffer[id.x] = CheckVisable(center, extent) ? 0 : 1;
}

// --- Kernel 2 & 3: GPU-Driven Instance 剔除与 LOD ---

StructuredBuffer<uint> _BatchOutputOffsets;           // 子批次起始位置 [BatchCount * 3]
RWStructuredBuffer<uint> _GlobalArgsBuffer;           // 参数池 [BatchCount * 3 * 5]

uint _TotalInstanceCount;
uint _BatchCount;

[numthreads(64, 1, 1)]
void CSClearArgs(uint3 id : SV_DispatchThreadID) {
    if (id.x >= _BatchCount) return;
    _GlobalArgsBuffer[id.x * 5 + 1] = 0; 
}

[numthreads(64, 1, 1)]
void CSMain_GlobalInstance(uint3 id : SV_DispatchThreadID) {
    if (id.x >= _TotalInstanceCount) return;

    GPUInstanceData data = GetInstanceData(id.x);
    
    // 1. 获取世界坐标中心 (矩阵的第四列)
    float3 worldPos = float3(data._matrix._m03, data._matrix._m13, data._matrix._m23);

    // 2. 距离剔除与 LOD 分级计算
    float dist = length(worldPos - _WorldSpaceCameraPos);
    uint lodLevel = 0;

    if (dist < data.lodDistances.x) lodLevel = 0;
    else if (dist < data.lodDistances.y) lodLevel = 1;
    else if (dist < data.lodDistances.z) lodLevel = 2;
    else return; 
    
    // 3. 计算缩放后的包围盒
    float3 scale = float3(
        length(float3(data._matrix._m00, data._matrix._m10, data._matrix._m20)),
        length(float3(data._matrix._m01, data._matrix._m11, data._matrix._m21)),
        length(float3(data._matrix._m02, data._matrix._m12, data._matrix._m22))
    );
    float3 worldExtent = data.extents * scale;
    
    
    // 4. Hiz 视锥 + 深度剔除
    if (CheckVisable(worldPos, worldExtent)) {
        uint subBatchIdx = data.batchIndex * 3 + lodLevel;
        uint argsInstanceCountPos = subBatchIdx * 5 + 1;
        
        uint count;
        InterlockedAdd(_GlobalArgsBuffer[argsInstanceCountPos], 1, count);
        
        // 5. 写入可见索引纹理
        uint writeOffset = _BatchOutputOffsets[subBatchIdx] + count;
        int2 uvVisible = int2(writeOffset % _TexWidth, writeOffset / _TexWidth);
        _GlobalVisibleIndexTex[uvVisible] = id.x;
    }
}

// [新增绑定] 用于接收 CPU 过滤后下标的缓冲区
StructuredBuffer<uint> _InputIndicesBuffer;
uint _CPUFilteredCount;

[numthreads(64, 1, 1)]
void CSMain_GlobalInstance_Filtered(uint3 id : SV_DispatchThreadID) {
    if (id.x >= _CPUFilteredCount) return;

    // 1. 拿到 CPU 传过来的打包数据
    uint packedData = _InputIndicesBuffer[id.x];
    
    // 2. 【核心修改】：位解包
    // 取高 2 位得到 LOD 等级 (0, 1, 2)
    uint lodLevel = packedData >> 30;
    // 取低 30 位得到真实的全局实例 ID
    uint instanceId = packedData & 0x3FFFFFFF;
    
    GPUInstanceData data = GetInstanceData(instanceId);
    
    // 3. 获取世界坐标中心 (还原 C# 内存布局)
    float3 worldPos = float3(data._matrix._m03, data._matrix._m13, data._matrix._m23);

    // 4. 计算缩放后的包围盒 (用于 Hiz 剔除测试)
    float3 scale = float3(
        length(float3(data._matrix._m00, data._matrix._m10, data._matrix._m20)),
        length(float3(data._matrix._m01, data._matrix._m11, data._matrix._m21)),
        length(float3(data._matrix._m02, data._matrix._m12, data._matrix._m22))
    );
    float3 worldExtent = data.extents * scale;

    // 5. Hiz 精确遮挡测试
    if (CheckVisable(worldPos, worldExtent)) {
        // 直接使用解包出来的 CPU lodLevel，不再计算距离！
        uint subBatchIdx = data.batchIndex * 3 + lodLevel;
        uint argsInstanceCountPos = subBatchIdx * 5 + 1;
        
        // 6. 原子累加实例计数
        uint count;
        InterlockedAdd(_GlobalArgsBuffer[argsInstanceCountPos], 1, count);

        // 7. 写入可见索引列表
        uint writeOffset = _BatchOutputOffsets[subBatchIdx] + count;
        int2 uvVisible = int2(writeOffset % _TexWidth, writeOffset / _TexWidth);
        _GlobalVisibleIndexTex[uvVisible] = instanceId;
    }
}