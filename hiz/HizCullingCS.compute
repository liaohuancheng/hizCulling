#pragma kernel CSMain

#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

// 输入：一维包围盒数据
StructuredBuffer<float4> _AABBCenterBuffer;
StructuredBuffer<float4> _AABBExtentBuffer;

// 输入：HiZ图集和矩阵参数
Texture2D<float> _HizMipAtlas;
float4x4 _HizCullVP;
float4 _HizMinMaxMipAndScreenSize;
float4 _HizAtlasMipScaleOffset[16];
uint _CullableCount;

// 输出：一维剔除结果 (0: 剔除, 1: 可见)
RWStructuredBuffer<uint> _CullResultBuffer;

// 与原版一致的 NDC 转换逻辑
float3 TransformWorldToNDC(float3 worldPos)
{
    float4 ndc = mul(_HizCullVP, float4(worldPos, 1));
    ndc.xyz /= ndc.w;                       
    #ifdef UNITY_REVERSED_Z
    ndc.xy = ndc.xy * 0.5f + 0.5f;          
    #else
    ndc.xyz = ndc.xyz * 0.5f + 0.5f;         
    #endif
    ndc.y = 1.0 - ndc.y;                    
    return ndc.xyz;
}[numthreads(64, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    // 如果超出了实际要剔除的物体数量，直接返回
    if (index >= _CullableCount) return;

    // 1. 直接从 Buffer 读取 AABB 数据
    float3 aabbCenter = _AABBCenterBuffer[index].xyz;
    float3 aabbExtent = _AABBExtentBuffer[index].xyz;

    float3 aabbMax = aabbCenter + aabbExtent;
    float3 aabbMin = aabbCenter - aabbExtent;

    // 2. 求出包围盒的八个点世界坐标
    float3 boxCorners[8] = {
        float3(aabbMin.x, aabbMin.y, aabbMin.z),
        float3(aabbMin.x, aabbMin.y, aabbMax.z),
        float3(aabbMin.x, aabbMax.y, aabbMin.z),
        float3(aabbMax.x, aabbMin.y, aabbMin.z),
        float3(aabbMax.x, aabbMax.y, aabbMin.z),
        float3(aabbMax.x, aabbMin.y, aabbMax.z),
        float3(aabbMin.x, aabbMax.y, aabbMax.z),
        float3(aabbMax.x, aabbMax.y, aabbMax.z)
    };

    // 3. 转换到 NDC 并求 Min/Max
    float4 ndc0 = mul(_HizCullVP, float4(boxCorners[0], 1));
    if (ndc0.w <= _ProjectionParams.y) {
        // 如果有顶点在近平面外，不剔除
        _CullResultBuffer[index] = 1;
        return;
    }

    float3 ndcMin = TransformWorldToNDC(boxCorners[0]);
    float3 ndcMax = ndcMin;

    [unroll]
    for (int i = 1; i < 8; i++) {
        float3 ndcPos = TransformWorldToNDC(boxCorners[i]);
        ndcMin = min(ndcMin, ndcPos);
        ndcMax = max(ndcMax, ndcPos);
    }

    // 4. 计算 Mip 等级和读取位置
    float2 screenAABBSize = floor((ndcMax.xy - ndcMin.xy) * _HizMinMaxMipAndScreenSize.zw);
    float screenAABBRadius = max(screenAABBSize.x, screenAABBSize.y);
    int mipLevel = ceil(log2(screenAABBRadius));
    mipLevel = clamp(mipLevel, _HizMinMaxMipAndScreenSize.y, _HizMinMaxMipAndScreenSize.x);
    
    float4 atlasPixelOffsetSize = _HizAtlasMipScaleOffset[mipLevel];
    ndcMax = clamp(ndcMax, 0, 1);
    ndcMin = clamp(ndcMin, 0, 1);

    int4 screenPixelMinMax = (float4(ndcMin.xy, ndcMax.xy) * atlasPixelOffsetSize.xyxy + atlasPixelOffsetSize.zwzw);
    int2 minBoundary = (int2)atlasPixelOffsetSize.zw;
    int2 maxBoundary = (int2)(atlasPixelOffsetSize.zw + atlasPixelOffsetSize.xy - 1.0);

    screenPixelMinMax.xy = clamp(screenPixelMinMax.xy, minBoundary, maxBoundary);
    screenPixelMinMax.zw = clamp(screenPixelMinMax.zw, minBoundary, maxBoundary);

    // 5. 纹素采样 深度图
    float lbDepth = _HizMipAtlas.Load(int3(screenPixelMinMax.xy, 0));
    float rbDepth = _HizMipAtlas.Load(int3(screenPixelMinMax.zy, 0));
    float ltDepth = _HizMipAtlas.Load(int3(screenPixelMinMax.xw, 0));
    float rtDepth = _HizMipAtlas.Load(int3(screenPixelMinMax.zw, 0));

    // 6. 对比深度，写入结果 (1:可见, 0:剔除)
    float maxDepth = max(max(max(lbDepth, rbDepth), ltDepth), rtDepth);
    _CullResultBuffer[index] = (maxDepth < ndcMin.z) ? 1 : 0;
}